[user]
	email = hi@dpat.in
	name = Den Patin
	signingkey = B01C765229A55F73
[init]
	defaultBranch = main
[commit]
	gpgsign = false
	verbose = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
	side-by-side = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
	algorithm = histogram
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
	pruneTags = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[help]
	autocorrect = prompt
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
