{
  "files.autoSave": "afterDelay",
  "diffEditor.ignoreTrimWhitespace": false,
  "remote.autoForwardPortsSource": "hybrid",
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "chat.tools.terminal.autoApprove": {
    "history": true
  },
  "makefile.configureOnOpen": false,
  "workbench.startupEditor": "none",
  "chat.viewSessions.enabled": false,
  "workbench.colorTheme": "GitHub Light Default",
  "chat.agent.maxRequests": 200,
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://github.com/serpapi/nokolexbor": true
  },
  "git.autofetch": true,
  "git.confirmSync": false,
  "comments.openView": "never",
  "latex-workshop.latex.tools": [
    {
      "name": "tectonic",
      "command": "tectonic",
      "args": [
        "--synctex",
        "--keep-logs",
        "%DOC%.tex"
      ]
    },
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "tectonic (Fastest)",
      "tools": [
        "tectonic"
      ]
    },
    {
      "name": "latexmk (Classic)",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "[typst]": {
    "editor.defaultFormatter": "myriad-dreamin.tinymist",
    "editor.formatOnSave": true
  },
  "tinymist.formatterMode": "typstyle",
  "tinymist.exportPdf": "onSave",
  "editor.fontFamily": "'JetBrains Mono', 'Menlo', 'Monaco', 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.lineHeight": 20,
  "editor.letterSpacing": 0.5,
  "editor.fontWeight": "400",
  "workbench.fontAliasing": "antialiased",
  "editor.minimap.enabled": false,
  "editor.matchBrackets": "near",
  "editor.occurrencesHighlight": "off",
  "editor.guides.bracketPairs": "active",
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "GitHub Light Default",
  "workbench.preferredDarkColorTheme": "Tokyo Night Storm",
  "terminal.integrated.fontFamily": "'JetBrains Mono'",
  "C_Cpp.intelliSenseEngine": "disabled",
  "zig.zls.enabled": "on",
  "zig.path": "zig",
  "C_Cpp.default.cppStandard": "c++23",
  "C_Cpp.default.cStandard": "c23",
  "C_Cpp.default.compilerPath": "",
  "fortran.formatting.formatter": "fprettify",
  "fortran.preferredCase": "lowercase",
  "fortran.formatting.fprettifyArgs": [
    "--case", "1", "1", "1", "1"
  ],
  "[FortranFreeForm]": {
    "editor.defaultFormatter": "fortran-lang.linter-gfortran",
    "editor.formatOnSave": true
  },
  "chat.byokUtilityModelDefault": "mainAgent",
  "chat.utilityModel": "",
  "chat.utilitySmallModel": ""
}
